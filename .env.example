# Copy this file to .env (gitignored) and fill in real local values.
# .env is read by DotenvEnvironmentPostProcessor (backed by dotenv-java) and populates
# the ${...} placeholders in src/main/resources/application.properties for local runs.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_api
DB_USERNAME=blog_api
DB_PASSWORD=blog_api
JWT_SECRET=change-me-at-least-32-characters-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
